{
  "name": "quitclaim",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @quitclaim/web dev",
    "build": "pnpm --filter @quitclaim/web build",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --filter @quitclaim/sdk test",
    "test:e2e": "pnpm --filter @quitclaim/web test:e2e",
    "test:e2e:smoke": "pnpm --filter @quitclaim/web test:e2e:smoke",
    "evidence": "node scripts/evidence.mjs",
    "evidence:refresh": "node scripts/refresh-onchain-evidence.mjs",
    "demo:night": "node scripts/demo-night.mjs",
    "test:hostile": "node scripts/hostile-mid-payout.mjs",
    "sync:sdk": "bash scripts/sync-sdk.sh",
    "verify:all": "pnpm test:unit && pnpm evidence && pnpm sync:sdk && pnpm build"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
